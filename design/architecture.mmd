flowchart LR
  human(["Human operator"])
  tui["Cronos CLI / TUI"]

  subgraph host["Cronos Rust host · state owner"]
    queue["Ready queue<br/>Priority + dependencies<br/>One active task in MVP"]
    state[("Project + task JSON")]
    workspace["Per-attempt worktree<br/>and local branch"]
    stepRunner["Workflow host<br/>Validates status, step,<br/>approval and worktree"]
    approval{{"Human approval<br/>Specs + final code"}}
    merger["Clean checks<br/>Local merge"]
  end

  subgraph pi["Pi orchestrator"]
    session["Pi RPC session"]
    extension["Cronos workflow extension"]
  end

  subgraph herdr["Herdr agent runtime"]
    agents["Agents for current step<br/>Concurrent within the step"]
  end

  openspec["OpenSpec"]
  repository[("User's local Git repository")]
  completed(["Completed"])
  error(["Error"])
  rejected(["Rejected"])

  human --> tui
  tui -->|create and select project, create task| queue
  queue -->|load and persist| state
  queue -->|assign attempt| workspace
  queue -->|launch assigned task| session
  workspace --> repository

  session --> extension
  extension -->|read-only task query| state
  extension -->|run current step| stepRunner
  stepRunner -->|start step agents| agents
  agents -->|results; wait for all| stepRunner
  agents -->|work in assigned worktree| workspace
  agents -->|specification step| openspec
  stepRunner -->|validated step and activity updates| state
  stepRunner -->|approval step reached| approval
  tui -->|approve or request revision| approval
  approval -->|validated decision| state
  approval -->|continue or revise| stepRunner
  stepRunner -->|documentation changes committed| workspace
  stepRunner -->|after final approval and docs| merger
  merger <-->|worktree and local merge| repository
  merger -->|success| completed
  completed --> state

  agents -. failure: cancel siblings .-> error
  merger -. conflict: abort merge .-> error
  error -->|human retries or clarifies| workspace
  error -->|human abandons| rejected
  rejected --> state

  classDef person fill:#F1F5FA,stroke:#667A90,color:#16283D,stroke-width:1.5px;
  classDef host fill:#EAF5F4,stroke:#188C83,color:#153C42,stroke-width:1.5px;
  classDef agent fill:#F0EEFA,stroke:#7966B5,color:#302950,stroke-width:1.5px;
  classDef external fill:#FFF4E3,stroke:#C38A3E,color:#4B371F,stroke-width:1.5px;
  classDef success fill:#E7F6EC,stroke:#39935B,color:#183E27,stroke-width:1.5px;
  classDef failure fill:#FFF0ED,stroke:#CB6A56,color:#55271F,stroke-width:1.5px;

  class human,tui person;
  class queue,state,workspace,stepRunner,approval,merger host;
  class session,extension,agents agent;
  class openspec,repository external;
  class completed success;
  class error,rejected failure;
