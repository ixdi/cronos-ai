  "cards": [
    {
      "dot": "cyan",
      "title": "Human supervision",
      "items": [
        "The operator CLI exposes approval, rejection with feedback, and explicit resume.",
        "Rejection repeats implementation and checks; approval gates documentation and delivery."
      ]
    },
    {
      "dot": "emerald",
      "title": "Isolation and recovery",
      "items": [
        "Each task gets a Docker runtime and worktree; agents see shared Git metadata read-only.",
        "SQLite checkpoints survive restart. Active tasks are interrupted, never auto-resumed."
      ]
    },
    {
      "dot": "rose",
      "title": "Controlled delivery",
      "items": [
        "The host owns commits and repository-scoped GitHub credentials; agents do not push.",
        "Cronos records the PR and stops tracking; PR and CI monitoring are out of MVP scope."
      ]
    }
  ]
